source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-redirect-from"
end

# GFM-flavoured Markdown is no longer bundled with Jekyll 4.
gem "kramdown-parser-gfm"

# Render TeX to HTML at build time, so no math JavaScript ships to the browser.
gem "kramdown-math-katex"
gem "katex"
gem "execjs"
